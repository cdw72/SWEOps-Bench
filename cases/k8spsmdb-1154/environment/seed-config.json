{
  "case_id": "k8spsmdb-1154",
  "k8s_version": "v1.28",
  "operator_bundle": "bundle.yaml",
  "operator_ready": [
    "-n psmdb get deploy percona-server-mongodb-operator",
    "1/1"
  ],
  "operator_ready_timeout": 1500,
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "psmdb",
      "wait": [
        [
          "get sts test-cluster-rs0",
          "test-cluster-rs0"
        ]
      ],
      "timeout": 600,
      "settle": 180
    }
  ],
  "settle_sec": 60,
  "fault_verify": [
    [
      "-n psmdb get pod test-cluster-rs0-0 -o jsonpath='{.spec.containers[*].args}'",
      "enableEncryption"
    ],
    [
      "-n psmdb get pod test-cluster-rs0-0 -o jsonpath='{.spec.containers[*].args}'",
      "storageEngine=inMemory"
    ]
  ],
  "image_rewrites": [],
  "ensure_ns": [
    "psmdb"
  ],
  "apply_ns": "psmdb",
  "poll_pre_sequence": [
    {
      "file": "poll-healthy.yaml",
      "ns": "psmdb",
      "settle": 120
    }
  ],
  "poll_fault": [
    [
      "-n",
      "psmdb",
      "apply",
      "-f",
      "/seed-data/mutated-000.yaml"
    ]
  ],
  "poll_fault_settle": 180,
  "poll_why": "故障住在种子自带的 CR 里(cr_sequence 一步就 apply mutated-000.yaml,rs0 storage.engine=inMemory),所以要先补全健康前缀:pre 相位只 apply 健康孪生 CR,注入时刻由 trigger 重放故障 CR。另外四个副本段各补 affinity.antiAffinityTopologyKey: none —— 单节点集群上按 hostname 打散的 size=3 副本段只能起来 1 个,会留下结构性告警;与本案故障无关,但不戴这顶帽子健康态到不了 READY。"
}
