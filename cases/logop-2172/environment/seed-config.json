{
  "case_id": "logop-2172",
  "k8s_version": "v1.28",
  "operator_bundle": "chart-rendered-6.3.1.yaml",
  "operator_ready": [
    "-n default get deploy logop-logging-operator",
    "1/1"
  ],
  "operator_ready_timeout": 1500,
  "cr_sequence": [
    {
      "file": "fluentbit-agent.yaml",
      "ns": "default",
      "settle": 5
    },
    {
      "file": "logging-cr.yaml",
      "ns": "default",
      "settle": 30
    }
  ],
  "settle_sec": 30,
  "fault_verify": [],
  "fault_verify_after": [
    [
      "-n default logs deploy/logop-logging-operator --tail=2000",
      "Observed a panic"
    ]
  ],
  "image_rewrites": [],
  "ensure_ns": [
    "default"
  ],
  "pre_manifests": [
    "logop-crds.yaml",
    "prometheus-crds-minimal.yaml"
  ],
  "trigger_script": "logop-2172.sh",
  "poll_healthy_steps": 1,
  "poll_fault": [
    [
      "-n",
      "default",
      "apply",
      "-f",
      "/seed-data/logging-cr.yaml"
    ]
  ],
  "poll_fault_settle": 30,
  "poll_why": "本案的 trigger 是显性化触发器(只断言前置在位、不造故障),而故障就是那些前置本身:pre 相位 apply logging-cr.yaml 会让算子直接 panic ⇒ 基线从一开始就是故障态。现在 pre 相位只 apply fluentbit-agent.yaml(spec 为空、无人消费 ⇒ 算子空跑不 panic),logging-cr.yaml 改由 trigger 在注入时刻 apply。"
}
