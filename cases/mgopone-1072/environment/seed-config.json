{
  "case_id": "mgopone-1072",
  "operator_ready_timeout": 900,
  "ensure_ns": [
    "mongodb"
  ],
  "k8s_version": "v1.23",
  "operator_bundle": "bundle.yaml",
  "operator_ready": [
    "-n mongodb get deploy mongodb-kubernetes-operator",
    "1/1"
  ],
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "mongodb",
      "wait": [
        [
          "get mongodbcommunity test-cluster -o jsonpath={.status.phase}",
          "Running"
        ]
      ],
      "timeout": 900
    },
    {
      "file": "mutated-001.yaml",
      "ns": "mongodb",
      "settle": 240,
      "timeout": 600
    }
  ],
  "settle_sec": 30,
  "fault_verify": [
    [
      "-n mongodb get mongodbcommunity test-cluster -o jsonpath={.status.phase}",
      "Pending"
    ],
    [
      "-n mongodb get pods",
      "Running"
    ],
    [
      "-n mongodb get events --sort-by=.lastTimestamp",
      "ReplicaSet is not yet ready"
    ]
  ],
  "image_rewrites": [],
  "poll_healthy_steps": 1,
  "poll_fault": [
    [
      "-n",
      "mongodb",
      "apply",
      "-f",
      "/seed-data/mutated-001.yaml"
    ]
  ],
  "poll_fault_settle": 240
}
