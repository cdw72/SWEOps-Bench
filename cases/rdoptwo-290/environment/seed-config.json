    "1/1"
  ],
  "operator_ready_timeout": 1500,
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "redis-operator",
      "wait": [
        [
          "get sts test-cluster-leader -o jsonpath={.status.readyReplicas}",
          "3"
        ]
