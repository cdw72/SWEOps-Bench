{
  "case_id": "k8spsmdb-434",
  "k8s_version": "v1.21",
  "operator_bundle": "bundle.yaml",
  "operator_ready": [
    "-n psmdb get deploy percona-server-mongodb-operator",
    "1/1"
  ],
  "operator_ready_timeout": 1500,
  "cr_sequence": [
    {
      "file": "secrets-434.yaml",
      "ns": "psmdb"
    },
    {
      "file": "cr-434.yaml",
      "ns": "psmdb",
      "wait": [
        [
          "get pod mongodb-cluster-rs0-2",
          "Running"
        ],
        [
          "get pod mongodb-cluster-cfg-0",
          "Running"
        ],
        [
          "get pods -l app.kubernetes.io/component=mongos",
          "Running"
        ]
      ],
      "timeout": 1800,
      "settle": 120
    }
  ],
  "settle_sec": 30,
  "fault_verify": [],
  "fault_verify_after": [
    [
      "-n psmdb logs deploy/percona-server-mongodb-operator --previous --tail=400",
      "Observed a panic"
    ],
    [
      "-n psmdb logs deploy/percona-server-mongodb-operator --previous --tail=400",
      "nil pointer"
    ],
    [
      "-n psmdb logs deploy/percona-server-mongodb-operator --previous --tail=400",
      "mgo.go"
    ]
  ],
  "image_rewrites": [],
  "ensure_ns": [
    "psmdb"
  ],
  "trigger_script": "k8spsmdb-434.sh",
  "apply_ns": "psmdb",
  "poll_healthy_steps": 2
}
