{
  "case_id": "rdoptwo-1863",
  "ensure_ns": [
    "redis-operator"
  ],
  "k8s_version": "v1.28",
  "operator_bundle": "bundle_v0-26-0.yaml",
  "operator_ready": [
    "-n redis-operator get deploy redis-operator",
    "1/1"
  ],
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "redis-operator",
      "wait": [
        [
          "get sts",
          "test-cluster-leader"
        ],
        [
          "get pods",
          "Running"
        ]
      ],
      "timeout": 420
    },
    {
      "file": "mutated-001.yaml",
      "ns": "redis-operator",
      "settle": 45
    }
  ],
  "settle_sec": 60,
  "image_rewrites": [
    [
      "quay.io/opstree/redis-operator:srcfix-1863",
      "quay.io/opstree/redis-operator:v0.26.0"
    ]
  ],
  "operator_ns": "default",
  "apply_ns": "redis-operator",
  "pre_manifests": [
    "redis-tls.yaml"
  ],
  "fault_verify": [
    [
      "-n redis-operator get pod test-cluster-leader-0 -o jsonpath='{.status.phase}'",
      "Running"
    ],
    [
      "-n redis-operator logs deploy/redis-operator --tail=300",
      "Could not execute command"
    ]
  ],
  "poll_healthy_steps": 1,
  "poll_fault": [
    [
      "-n",
      "redis-operator",
      "apply",
      "-f",
      "/seed-data/mutated-001.yaml"
    ]
  ],
  "poll_fault_settle": 45,
  "poll_pre_sequence": [
    {
      "file": "poll-healthy.yaml",
      "ns": "redis-operator",
      "settle": 120
    }
  ],
  "poll_why": "健康前缀与故障 CR 只差 TLS 那一块:mutated-000 本身就带 TLS,与注入时刻重放的 mutated-001 唯一差异是 metadata.annotations.sweops-trivial。健康前缀改用 poll-healthy.yaml(把 spec.TLS 及相关字段整块摘掉),注入仍由 trigger 重放 mutated-001,把 TLS 那一刀在注入时刻带进来。注:本 config 必须带全套 poll_ 键,只写前缀会被当成已完成、故障不再注入。"
}
