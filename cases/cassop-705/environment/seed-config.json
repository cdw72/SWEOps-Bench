{
  "case_id": "cassop-705",
  "k8s_version": "v1.23",
  "operator_bundle": "bundle.yaml",
  "ensure_sc": [
    {
      "name": "standard"
    }
  ],
  "operator_ready": [
    "-n cass-operator get deploy cass-operator-controller-manager",
    "1/1"
  ],
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "cass-operator",
      "wait": [
        [
          "get sts",
          "development-test-cluster-rack1-sts"
        ],
        [
          "get pods",
          "Running"
        ]
      ],
      "timeout": 420
    },
    {
      "file": "mutated-001.yaml",
      "ns": "cass-operator",
      "settle": 60
    }
  ],
  "settle_sec": 60,
  "image_rewrites": [
    [
      "k8ssandra/cass-operator:srcbuggy-696",
      "k8ssandra/cass-operator:v1.22.1"
    ]
  ],
  "operator_ns": "default",
  "pre_manifests": [
    "cert-manager.yaml"
  ],
  "pre_ready": [
    [
      "-n cert-manager get endpoints cert-manager-webhook",
      "10250"
    ],
    [
      "get mutatingwebhookconfiguration cert-manager-webhook -o jsonpath='{.webhooks[*].clientConfig.caBundle}'",
      "LS0t"
    ],
    [
      "get validatingwebhookconfiguration cert-manager-webhook -o jsonpath='{.webhooks[*].clientConfig.caBundle}'",
      "LS0t"
    ]
  ],
  "trigger_script": "cassop-705.sh",
  "poll_healthy_steps": 1,
  "poll_fault": [
    [
      "-n",
      "cass-operator",
      "apply",
      "-f",
      "/seed-data/mutated-001.yaml"
    ]
  ],
  "poll_fault_settle": 60,
  "poll_why": "健康前缀截到 cr_sequence[:1](mutated-000,一个 bare datacenter 的干净基线)。用更长的前缀时 pre 相位会连 mutated-001 一起 apply,而它的 spec.configSecret 指向的 secret 要到 trigger 阶段才创建 ⇒ 算子从 t=0 起持续 requeue、DC 长时间 Updating、rack pod 只有 Running 不 Ready,基线看起来就是带病的。故障语义不变:trigger 仍在注入时刻重放 mutated-001 并创建 secret。"
}
