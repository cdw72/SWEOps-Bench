{
  "case_id": "vmop-1828",
  "operator_ready_timeout": 900,
  "ensure_ns": [
    "vm"
  ],
  "k8s_version": "v1.28",
  "operator_bundle": "bundle.yaml",
  "operator_ready": [
    "-n vm get deploy operator",
    "1/1"
  ],
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "default",
      "wait": [
        [
          "-n default get deploy vmagent-vmagent",
          "vmagent-vmagent"
        ],
        [
          "-n default get pods -o name",
          "vmagent-vmagent"
        ]
      ],
      "settle": 90,
      "timeout": 300
    }
  ],
  "settle_sec": 30,
  "fault_verify": [
    [
      "-n default logs deploy/vmagent-vmagent -c config-reloader --tail=300",
      "forbidden"
    ]
  ],
  "image_rewrites": [],
  "poll_pre_sequence": [
    {
      "file": "poll-healthy.yaml",
      "ns": "default",
      "settle": 60
    }
  ],
  "poll_fault_script": "poll-inject.sh",
  "poll_fault_settle": 120
}
