{
  "case_id": "vmop-1802",
  "operator_ready_timeout": 900,
  "ensure_ns": [
    "vm"
  ],
  "k8s_version": "v1.28",
  "operator_bundle": "bundle.yaml",
  "operator_ready": [
    "-n vm get deploy operator",
    "1/1"
  ],
  "cr_sequence": [
    {
      "file": "mutated-000.yaml",
      "ns": "default",
      "settle": 120,
      "timeout": 420
    }
  ],
  "settle_sec": 60,
  "fault_verify": [
    [
      "-n default get events --sort-by=.lastTimestamp",
      "Too long"
    ]
  ],
  "image_rewrites": [],
  "poll_pre_sequence": [
    {
      "file": "poll-healthy.yaml",
      "ns": "default",
      "settle": 120
    }
  ],
  "poll_fault_script": "poll-inject.sh",
  "poll_fault_settle": 60
}
